rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function authorizationPath(emailNormalized) {
      return /databases/$(database)/documents/authorizedUsers/$(emailNormalized);
    }

    function hasAuthorization(emailNormalized) {
      return signedIn()
        && emailNormalized is string
        && exists(authorizationPath(emailNormalized))
        && get(authorizationPath(emailNormalized)).data.isActive == true;
    }

    function authorization(emailNormalized) {
      return get(authorizationPath(emailNormalized)).data;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.isActive == true
        && hasAuthorization(get(userPath()).data.emailNormalized);
    }

    function currentUser() {
      return get(userPath()).data;
    }

    function isAdmin() {
      return hasUserProfile()
        && (currentUser().role == "admin" || currentUser().role == "administrateur")
        && authorization(currentUser().emailNormalized).role in ["admin", "administrateur"];
    }

    function sameCompany(companyId) {
      return hasUserProfile()
        && currentUser().companyId == companyId
        && authorization(currentUser().emailNormalized).companyId == companyId;
    }

    function companyIdIsUnchanged() {
      return request.resource.data.companyId == resource.data.companyId;
    }

    function hasRequiredCompanyId() {
      return request.resource.data.companyId is string;
    }

    function validOwnProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && hasAuthorization(request.resource.data.emailNormalized)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.companyId == authorization(request.resource.data.emailNormalized).companyId
        && request.resource.data.role == authorization(request.resource.data.emailNormalized).role
        && request.resource.data.isActive == authorization(request.resource.data.emailNormalized).isActive
        && request.resource.data.createdAt is string
        && request.resource.data.lastLoginAt is string;
    }

    function isOwnAuthorizationDocument(emailId) {
      return signedIn()
        && request.auth.token.email is string
        && resource.data.email is string
        && resource.data.emailNormalized == emailId
        && resource.data.email == request.auth.token.email;
    }

    match /authorizedUsers/{emailId} {
      allow get: if isOwnAuthorizationDocument(emailId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if false;
      allow update: if sameCompany(companyId) && isAdmin();
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId && hasUserProfile();
      allow create: if validOwnProfileCreate(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && hasUserProfile()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.emailNormalized == resource.data.emailNormalized
        && request.resource.data.companyId == authorization(resource.data.emailNormalized).companyId
        && request.resource.data.role == authorization(resource.data.emailNormalized).role
        && request.resource.data.isActive == authorization(resource.data.emailNormalized).isActive
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "email",
          "displayName",
          "photoURL",
          "companyId",
          "role",
          "isActive",
          "lastLoginAt",
          "preferredLanguage",
          "preferredLanguageLabel",
          "languageConfiguredAt",
          "updatedAt"
        ]);
      allow delete: if false;
    }

    match /diagnostics/{diagnosticId} {
      allow read: if sameCompany(resource.data.companyId)
        && (resource.data.technicianId == request.auth.uid || isAdmin());
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.status in [
          "draft",
          "uploading_photos",
          "ready_for_analysis",
          "analyzing",
          "awaiting_technician_input",
          "completed",
          "archived",
          "analysis_failed"
        ];
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.technicianId == resource.data.technicianId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedBy == request.auth.uid
        && (resource.data.technicianId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /diagnosticPhotos/{photoId} {
      allow read: if sameCompany(resource.data.companyId)
        && (resource.data.uploadedBy == request.auth.uid || isAdmin());
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.uploadedBy == request.auth.uid;
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.uploadedBy == resource.data.uploadedBy
        && (resource.data.uploadedBy == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /diagnosticMessages/{messageId} {
      allow read: if sameCompany(resource.data.companyId)
        && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /diagnosticDocumentLinks/{linkId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId() && sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId) && companyIdIsUnchanged();
      allow delete: if false;
    }

    match /technicalMemoryFeedbacks/{feedbackId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.id == feedbackId
        && feedbackId == "technical-memory-" + request.resource.data.diagnosticId
        && request.resource.data.technicianId == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diagnosticId is string
        && request.resource.data.actualCause in [
          "sonde_defectueuse",
          "carte_electronique_hs",
          "ventilateur_bloque",
          "manque_de_fluide",
          "fuite_detectee",
          "connecteur_desserre",
          "mauvais_cablage",
          "parametrage",
          "autre"
        ]
        && request.resource.data.repairResult in ["repare", "repare_partiellement", "non_repare"]
        && request.resource.data.timeSpentMinutes is number
        && request.resource.data.timeSpentMinutes > 0
        && (!("comment" in request.resource.data) || request.resource.data.comment.size() <= 1200)
        && (!("actualCauseOther" in request.resource.data) || request.resource.data.actualCauseOther.size() <= 160)
        && (!("actionOther" in request.resource.data) || request.resource.data.actionOther.size() <= 160);
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.id == resource.data.id
        && request.resource.data.diagnosticId == resource.data.diagnosticId
        && request.resource.data.technicianId == resource.data.technicianId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.timeSpentMinutes is number
        && request.resource.data.timeSpentMinutes > 0
        && (!("comment" in request.resource.data) || request.resource.data.comment.size() <= 1200)
        && (!("actualCauseOther" in request.resource.data) || request.resource.data.actualCauseOther.size() <= 160)
        && (!("actionOther" in request.resource.data) || request.resource.data.actionOther.size() <= 160)
        && (resource.data.technicianId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /interventions/{interventionId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.authorId == request.auth.uid;
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /technicalDocuments/{documentId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId() && sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId) && companyIdIsUnchanged();
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /documentLinks/{linkId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId() && sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId) && companyIdIsUnchanged();
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /documentFavorites/{favoriteId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if sameCompany(resource.data.companyId)
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /documentRecentViews/{recentViewId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.userId == request.auth.uid;
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.userId == resource.data.userId
        && resource.data.userId == request.auth.uid;
      allow delete: if sameCompany(resource.data.companyId)
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /documentImportBatches/{batchId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId()
        && sameCompany(request.resource.data.companyId)
        && request.resource.data.importedByUserId == request.auth.uid;
      allow update: if sameCompany(resource.data.companyId)
        && companyIdIsUnchanged()
        && request.resource.data.importedByUserId == resource.data.importedByUserId;
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /documentImportCandidates/{candidateId} {
      allow read: if sameCompany(resource.data.companyId);
      allow create: if hasRequiredCompanyId() && sameCompany(request.resource.data.companyId);
      allow update: if sameCompany(resource.data.companyId) && companyIdIsUnchanged();
      allow delete: if isAdmin() && sameCompany(resource.data.companyId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
