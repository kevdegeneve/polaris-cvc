rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userCompanyId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId;
    }

    function sameCompany(companyId) {
      return signedIn() && userCompanyId() == companyId;
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow write: if sameCompany(companyId)
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrateur";
    }

    match /users/{userId} {
      allow read: if signedIn() && sameCompany(resource.data.companyId);
      allow create: if signedIn() && sameCompany(request.resource.data.companyId);
      allow update: if signedIn() && sameCompany(resource.data.companyId);
    }

    match /{collection}/{documentId} {
      allow read: if signedIn() && sameCompany(resource.data.companyId);
      allow create: if signedIn() && sameCompany(request.resource.data.companyId);
      allow update, delete: if signedIn() && sameCompany(resource.data.companyId);
    }
  }
}
